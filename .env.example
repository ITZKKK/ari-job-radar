# Only for running on a laptop. On GitHub these are repository SECRETS
# (Settings -> Secrets and variables -> Actions) with exactly these names.
# Never commit a real .env.

# --- Email (option 1, recommended): Resend -----------------------------------
RESEND_API_KEY=
# Must be the email Ari used to sign up to Resend (the free sender only
# delivers to the account owner).
ALERT_TO=
# Optional. Leave empty unless a domain was verified in Resend.
RESEND_FROM=

# --- Email (option 2): SMTP with a dedicated throwaway Gmail ------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Optional job-search APIs ---------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Public address of the dashboard, used for the button in emails. On GitHub it
# is worked out automatically; set it only if you use a custom domain.
SITE_URL=
